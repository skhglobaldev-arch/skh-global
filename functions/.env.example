# Copy to functions/.env for Firebase Functions emulator only.
# Production secrets are set via: firebase functions:secrets:set <NAME>

ADMIN_EMAIL=you@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
SYSTEM_REVIEW_FROM_EMAIL=SKH.GLOBAL <you@gmail.com>
SYSTEM_REVIEW_ADMIN_EMAIL=admin@yourdomain.com
SITE_URL=http://localhost:5000
SKH_LOGO_URL=http://localhost:5000/skh-logo-mark.png
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
