# Admin access (server only)
ADMIN_EMAIL=you@yourdomain.com

# Gmail SMTP (server only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
SYSTEM_REVIEW_FROM_EMAIL=SKH.GLOBAL <you@gmail.com>
SYSTEM_REVIEW_ADMIN_EMAIL=admin@yourdomain.com

# Branding / site
SKH_LOGO_URL=https://your-domain.com/skh-logo-mark.png
SITE_URL=https://your-domain.com

# Firebase client (public — safe for frontend via Vite)
# For production deploy, copy these to .env.production before npm run build
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase admin (server only — NEVER expose in frontend)
# Optional on Cloud Functions (ADC used when omitted); required for local dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Gemini for server-side auto-replies (local dev only)
GEMINI_API_KEY=

# Local dev
PORT=3001
